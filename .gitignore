# ────────────────────────────────────────────────────────────
#  SECRETS & ENVIRONMENT  (most important — never commit these)
# ────────────────────────────────────────────────────────────
.env
.env.*
!.env.*.example
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
.secrets/


