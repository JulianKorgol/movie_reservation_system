# Runtime configuration for the frontend-main-app Next.js service.
# Copy this file to envs/.env.frontend-main-app and fill in real values.
# Never commit the non-example file — it is listed in .gitignore.

# Public variables (embedded at build time by Next.js — NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost/iam/v1
