# Runtime configuration for the microservice_iam Django service.
# Copy this file to envs/.env.microservice-iam and fill in real values.
# Never commit the non-example file — it is listed in .gitignore.

# Django core
DJANGO_SECRET_KEY=CHANGE_ME_50+_random_chars
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=microservice_iam,localhost

# Database (must match envs/.env.postgres-iam)
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres-iam
DB_PORT=5432
DB_NAME=iam_db
DB_USER=iam_user
DB_PASSWORD=CHANGE_ME_strong_password
